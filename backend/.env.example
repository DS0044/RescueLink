# RescueLink Server Configuration Example
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./rescuelink.db
ENVIRONMENT=production

# LoRa Physical & Simulation Layer
LORA_FREQUENCY_MHZ=868.1
LORA_DEFAULT_DELAY_MS=650
LORA_DEFAULT_LOSS_PERCENT=0.0

# Security & Authentication (JWT & Cookies)
# IMPORTANT: Generate a strong, unique 64-character secret in production!
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30
COOKIE_SECURE=true

# Demo Responder Passwords (CHANGE BEFORE REAL DEPLOYMENT)
DEMO_ADMIN_PASSWORD=SetAStrongAdminPassword123!
DEMO_COORDINATOR_PASSWORD=SetAStrongCoordPassword123!
DEMO_RESPONDER_PASSWORD=SetAStrongRespPassword123!
DEMO_PENDING_PASSWORD=SetAStrongPendingPassword123!
